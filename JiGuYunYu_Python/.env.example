# ---- 内部鉴权 ----
INTERNAL_TOKEN=changeme
INTERNAL_IP_WHITELIST=127.0.0.1

# ---- 环境 ----
ENV=dev
LOG_LEVEL=INFO

# ---- LLM (千帆) ----
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com

# ---- 向量库（ChromaDB + Sentence-BERT）----
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION=jigu_artifacts

# ---- 嵌入配置 ----
EMBEDDING_DIM=384
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Java 后端（知识库重建时 Python 调 Java 拉取 APPROVED 文物） ----
JAVA_BASE_URL=http://localhost:8080

# ---- 缓存 ----
REDIS_URL=redis://localhost:6379/0

# ---- 对象存储 (百度 BOS) ----
BOS_ENDPOINT=
BOS_ACCESS_KEY=
BOS_SECRET_KEY=
BOS_BUCKET=

# ---- VLM 检测模型 (Qwen3-VL-LoRA) ----
VLM_BASE_URL=
VLM_API_KEY=sk-123456
VLM_MODEL_NAME=qwen3-vl-lora
VLM_TIMEOUT=60.0

# ---- 超时 (秒) ----
HTTP_TIMEOUT=10.0
LLM_TIMEOUT=30.0
VECTOR_TIMEOUT=5.0
