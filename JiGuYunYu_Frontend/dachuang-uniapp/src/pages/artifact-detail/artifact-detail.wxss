.artifact-detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

.page-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #8B4513 0%, #65320F 100%);
  padding: calc(var(--status-bar-height) + 20rpx) 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.back-button {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  flex: 1;
  text-align: center;
  margin: 0 44rpx;
}

.placeholder {
  width: 44rpx;
  height: 44rpx;
}

.detail-content {
  padding-top: calc(var(--status-bar-height) + 88rpx);
}

.detail-card .image-section {
  background: #fff;
  padding-bottom: 32rpx;
}

.detail-card .image-section .image-swiper {
  width: 100%;
  height: 600rpx;
}

.detail-card .image-section .image-swiper .detail-image {
  width: 100%;
  height: 100%;
}

.detail-card .info-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
}

.detail-card .info-section .artifact-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.detail-card .info-section .artifact-header .artifact-name {
  flex: 1;
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
  margin-right: 16rpx;
}

.detail-card .info-section .artifact-header .status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.detail-card .info-section .artifact-header .status-badge .status-text {
  font-size: 24rpx;
  color: #fff;
}

.detail-card .info-section .artifact-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.detail-card .info-section .artifact-tags .tag {
  background: #F0F0F0;
  color: #666;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.detail-card .info-section .basic-info .info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-card .info-section .basic-info .info-row:last-child {
  border-bottom: none;
}

.detail-card .info-section .basic-info .info-row .info-label {
  font-size: 28rpx;
  color: #999;
}

.detail-card .info-section .basic-info .info-row .info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 32rpx;
}

.detail-card .description-section,
.detail-card .history-section,
.detail-card .craft-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
}

.detail-card .description-section .section-title,
.detail-card .history-section .section-title,
.detail-card .craft-section .section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.detail-card .description-section .description-text,
.detail-card .history-section .description-text,
.detail-card .craft-section .description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.detail-card .related-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
}

.detail-card .related-section .section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.detail-card .related-section .related-scroll {
  white-space: nowrap;
}

.detail-card .related-section .related-scroll .related-list {
  display: flex;
  gap: 20rpx;
}

.detail-card .related-section .related-scroll .related-list .related-item {
  display: inline-block;
  width: 240rpx;
  flex-shrink: 0;
}

.detail-card .related-section .related-scroll .related-list .related-item .related-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.detail-card .related-section .related-scroll .related-list .related-item .related-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-state .empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn .btn-icon {
  font-size: 32rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #C8102E 0%, #8B0A1F 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #C8102E;
  border: 2rpx solid #C8102E;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: #fff;
  padding: 40rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #C8102E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: #333;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}