.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
  background-color: #FFF8F0;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 16rpx;
}

.slogan {
  font-size: 24rpx;
  color: #9E7A57;
}

.login-section {
  width: 100%;
  max-width: 500rpx;
  margin-bottom: 60rpx;
}

.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background-color: #07C160;
  border-radius: 44rpx;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  border: none;
}

.wechat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.wechat-login-text {
  font-size: 32rpx;
  font-weight: 500;
}

.register-tip {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 60rpx;
}

.register-link {
  color: #8B4513;
  text-decoration: none;
  margin-left: 8rpx;
}

.footer {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
  line-height: 32rpx;
}

.footer-link {
  color: #8B4513;
  text-decoration: none;
  margin: 0 8rpx;
}