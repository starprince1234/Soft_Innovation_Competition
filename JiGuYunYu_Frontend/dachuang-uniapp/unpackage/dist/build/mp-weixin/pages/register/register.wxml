<view class="register-container">
  <view class="header">
    <text class="title">注册账号</text>
  </view>
  
  <view class="form-section">
    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" placeholder="请输入邮箱" placeholder-class="placeholder" data-field="email" bindinput="handleInput" value="{{email}}"></input>
    </view>
    
    <view class="form-item">
      <text class="label">验证码</text>
      <view class="code-input-container">
        <input class="input code-input" placeholder="请输入验证码" placeholder-class="placeholder" data-field="verificationCode" bindinput="handleInput" value="{{verificationCode}}"></input>
        <button class="code-btn" bindtap="sendVerificationCode" disabled="{{isCountingDown}}">{{isCountingDown ? countdown + 's' : '获取验证码'}}</button>
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input" placeholder="请输入用户名" placeholder-class="placeholder" data-field="username" bindinput="handleInput" value="{{username}}"></input>
    </view>
    
    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" placeholder-class="placeholder" data-field="password" bindinput="handleInput" value="{{password}}"></input>
    </view>
    
    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请再次输入密码" placeholder-class="placeholder" data-field="confirmPassword" bindinput="handleInput" value="{{confirmPassword}}"></input>
    </view>
    
    <button class="register-btn" bindtap="handleRegister">注册</button>
  </view>
  
  <view class="login-tip">
    <text>已有账号？</text>
    <navigator url="/pages/login/login" class="login-link">立即登录</navigator>
  </view>
</view>