<view class="feedback-page">
  <view class="page-header">
    <view class="back-btn" bindtap="handleBack">
      <text class="back-icon">←</text>
    </view>
    <text class="page-title">意见反馈</text>
    <view class="placeholder"></view>
  </view>

  <scroll-view class="feedback-content" scroll-y="true">
    <view class="feedback-form">
      <view class="form-section">
        <text class="section-title">反馈类型</text>
        <view class="type-selector">
          <view class="type-item" wx:for="{{ feedbackTypes }}" wx:key="item.value" bindtap="selectType" data-type="{{ item.value }}" class="{{ formData.type === item.value ? 'active' : '' }}">
            <text class="type-icon">{{ item.icon }}</text>
            <text class="type-label">{{ item.label }}</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <text class="section-title">反馈内容</text>
        <textarea class="feedback-textarea" bindinput="handleTextChange" placeholder="请详细描述您遇到的问题或建议..." maxlength="500"></textarea>
        <text class="char-count">{{ formData.textContent.length }}/500</text>
      </view>

      <view class="form-section">
        <text class="section-title">评分</text>
        <view class="rating-container">
          <text class="rating-label">您对应用的满意度</text>
          <view class="rating-stars">
            <text wx:for="[1, 2, 3, 4, 5]" wx:key="index" class="star {{ formData.rating >= item ? 'active' : '' }}" bindtap="selectRating" data-rating="{{ item }}">★</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <text class="section-title">上传截图（选填）</text>
        <view class="image-uploader">
          <view class="image-list">
            <view class="image-item" wx:for="{{ formData.images }}" wx:key="index">
              <image src="{{ item.url }}" mode="aspectFill"></image>
              <view class="delete-btn" bindtap="deleteImage" data-index="{{ index }}">×</view>
            </view>
            <view class="add-image-btn" wx:if="{{ formData.images.length < 3 }}" bindtap="chooseImage">
              <text class="add-icon">+</text>
              <text class="add-text">添加截图</text>
            </view>
          </view>
        </view>
        <text class="upload-tip">最多上传3张图片，每张不超过10MB</text>
      </view>

      <view class="form-section">
        <text class="section-title">联系方式（选填）</text>
        <input class="form-input" type="text" bindinput="handleContactChange" placeholder="请输入您的手机号或邮箱"></input>
      </view>

      <button class="submit-btn" bindtap="handleSubmit" disabled="{{ !canSubmit }}">
        {{ loading ? '提交中...' : '提交反馈' }}
      </button>
    </view>
  </scroll-view>

  <view class="loading-overlay" wx:if="{{ loading }}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">提交中...</text>
    </view>
  </view>
</view>