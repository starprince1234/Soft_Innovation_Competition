# ============================================================
# 稽古云语 - Docker Compose 环境变量模板
# 使用方式：复制此文件为 .env，填入真实值后启动
#   cp .env.example .env
#   docker compose up -d
# ============================================================

# ===== Docker 镜像 =====
DH_USER=starprince123
VER=0.1.0

# ===== Ports（仅本地调试暴露，生产环境通过 Nginx 反代）=====
MYSQL_PORT=3306
REDIS_PORT=6379
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# ===== MySQL =====
MYSQL_DATABASE=jigu
MYSQL_USER=jigu
MYSQL_PASSWORD=jigu_pass_change_me
MYSQL_ROOT_PASSWORD=root_pass_change_me

# ===== Spring Boot =====
SPRING_PROFILES_ACTIVE=docker

# ===== JWT =====
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_SECONDS=3600

# ===== 内部鉴权（Java ↔ Python）=====
INTERNAL_TOKEN=change_me_internal_token_very_secret
# IP 白名单（Docker 内网，留空=不启用白名单，适合 Docker 内部通信）
INTERNAL_IP_WHITELIST=

# ===== Python 服务 =====
PYTHON_ENV=production
PYTHON_LOG_LEVEL=INFO
UVICORN_WORKERS=2

# ===== VLM 检测模型（Qwen3-VL-LoRA on AutoDL）=====
# 在 AutoDL/自托管服务/云平台中找到 OpenAI-compatible API 地址，末尾通常为 /v1
VLM_BASE_URL=https://your-vlm-host.example.com/v1
VLM_API_KEY=your_vlm_api_key_here
VLM_MODEL_NAME=qwen3-vl-lora
VLM_TIMEOUT=60.0
VLM_ENABLE_THINKING=

# ===== 百度千帆 LLM =====
QIANFAN_API_KEY=change_me_qianfan_api_key
QIANFAN_SECRET_KEY=change_me_qianfan_secret_key
QIANFAN_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat/ernie-4.0-turbo-preview
LLM_TIMEOUT=180.0
PYTHON_CONNECT_TIMEOUT_MS=5000
PYTHON_READ_TIMEOUT_MS=180000

# ===== 向量库（ChromaDB + Sentence-BERT）=====
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION=jigu_artifacts
EMBEDDING_DIM=384
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ===== 百度 BOS 对象存储 =====
BOS_ENDPOINT=https://your-bos-endpoint.example.com
BOS_ACCESS_KEY=change_me_bos_access_key
BOS_SECRET_KEY=change_me_bos_secret_key
BOS_BUCKET=jigu-bucket
