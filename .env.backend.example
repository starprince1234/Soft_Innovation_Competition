# 镜像（本地调试默认用本地镜像）
JIGU_JAVA_IMAGE=jigu-java:0.1.0
JIGU_PYTHON_IMAGE=jigu-python:0.1.0

# 端口
MYSQL_PORT=3306
REDIS_PORT=6379
JAVA_PORT=8080
PYTHON_PORT=8000
NGINX_HTTP_PORT=80

# MySQL
MYSQL_DATABASE=jigu
MYSQL_USER=jigu
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

# Spring Boot
SPRING_PROFILES_ACTIVE=docker

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_SECONDS=3600

# Java ↔ Python 内部鉴权
INTERNAL_TOKEN=change_me_internal_token_very_secret
INTERNAL_IP_WHITELIST=

# Python
PYTHON_ENV=production
PYTHON_LOG_LEVEL=INFO
UVICORN_WORKERS=2

# 模型/向量配置
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL_NAME=qwen3-vl-lora
VLM_TIMEOUT=60.0
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
QIANFAN_BASE_URL=
VECTOR_BACKEND=chroma
VECTOR_DB_URL=
CHROMA_COLLECTION=jigu_artifacts
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# BOS
BOS_ENDPOINT=
BOS_ACCESS_KEY=
BOS_SECRET_KEY=
BOS_BUCKET=
