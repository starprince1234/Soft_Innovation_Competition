.register-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
  background-color: #FFF8F0;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
}

.form-section {
  flex: 1;
  width: 100%;
  max-width: 500rpx;
  align-self: center;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #8B4513;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333333;
  border: 2rpx solid #E8D8C5;
}

.placeholder {
  color: #CCCCCC;
}

.code-input-container {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  width: 200rpx;
  height: 88rpx;
  background-color: #8B4513;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  border: none;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  background-color: #8B4513;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  border: none;
  margin-top: 40rpx;
}

.login-tip {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-top: 40rpx;
}

.login-link {
  color: #8B4513;
  text-decoration: none;
  margin-left: 8rpx;
}