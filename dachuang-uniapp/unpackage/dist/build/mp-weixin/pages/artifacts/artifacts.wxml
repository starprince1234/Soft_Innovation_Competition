<view class="artifacts-page">
  <view class="page-header">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        value="{{searchKeyword}}"
        placeholder="搜索文物名称、年代..."
        bindconfirm="handleSearch"
      />
    </view>
    <view class="filter-btn" bindtap="showFilter = !showFilter">
      <text class="filter-icon">🔽</text>
      <text class="filter-text">筛选</text>
    </view>
  </view>

  <scroll-view
    class="artifact-list"
    scroll-y="true"
    bindscrolltolower="loadMore"
    refresher-enabled="true"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="list-content">
      <view
        class="artifact-card"
        wx:for="{{artifactList}}"
        wx:key="item.id || index"
        bindtap="goToDetail(item.id)"
      >
        <image class="artifact-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <view class="artifact-info">
          <text class="artifact-name">{{item.name}}</text>
          <view class="artifact-meta">
            <text class="meta-item">{{item.period}}</text>
            <text class="meta-item">{{item.material}}</text>
          </view>
          <view class="artifact-tags" wx:if="item.tags && item.tags.length > 0">
            <text class="tag" wx:for="{{item.tags.slice(0, 2)}}" wx:key="tagIndex">{{item}}</text>
          </view>
        </view>
      </view>

      <view wx:if="artifactList.length === 0 && !loading" class="empty-state">
        <image class="empty-image" src="/static/images/empty-artifacts.png"></image>
        <text class="empty-text">暂无文物数据</text>
      </view>
    </view>

    <view class="load-more" wx:if="hasMore">
      <text class="load-text">{{loading ? '加载中...' : '上拉加载更多'}}</text>
    </view>

    <view class="no-more" wx:if="!hasMore && artifactList.length > 0">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>

  <view class="filter-popup" class="{{showFilter ? 'show' : ''}}" catchtap="showFilter = !showFilter">
    <view class="filter-content" catchtap="">
      <view class="filter-header">
        <text class="filter-title">筛选条件</text>
        <text class="close-btn" bindtap="showFilter = !showFilter">✕</text>
      </view>

      <view class="filter-section">
        <text class="section-label">年代</text>
        <view class="filter-options">
          <text
            class="filter-option"
            class="{{filter.period === '' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('')"
          >
            全部
          </text>
          <text
            class="filter-option"
            class="{{filter.period === '商周' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('商周')"
          >
            商周
          </text>
          <text
            class="filter-option"
            class="{{filter.period === '秦汉' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('秦汉')"
          >
            秦汉
          </text>
          <text
            class="filter-option"
            class="{{filter.period === '隋唐' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('隋唐')"
          >
            隋唐
          </text>
          <text
            class="filter-option"
            class="{{filter.period === '宋元' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('宋元')"
          >
            宋元
          </text>
          <text
            class="filter-option"
            class="{{filter.period === '明清' ? 'active' : ''}}"
            bindtap="handleFilterPeriod('明清')"
          >
            明清
          </text>
        </view>
      </view>

      <view class="filter-section">
        <text class="section-label">材质</text>
        <view class="filter-options">
          <text
            class="filter-option"
            class="{{filter.material === '' ? 'active' : ''}}"
            bindtap="handleFilterMaterial('')"
          >
            全部
          </text>
          <text
            class="filter-option"
            class="{{filter.material === '青铜器' ? 'active' : ''}}"
            bindtap="handleFilterMaterial('青铜器')"
          >
            青铜器
          </text>
          <text
            class="filter-option"
            class="{{filter.material === '陶瓷' ? 'active' : ''}}"
            bindtap="handleFilterMaterial('陶瓷')"
          >
            陶瓷
          </text>
          <text
            class="filter-option"
            class="{{filter.material === '玉器' ? 'active' : ''}}"
            bindtap="handleFilterMaterial('玉器')"
          >
            玉器
          </text>
          <text
            class="filter-option"
            class="{{filter.material === '金银器' ? 'active' : ''}}"
            bindtap="handleFilterMaterial('金银器')"
          >
            金银器
          </text>
        </view>
      </view>

      <view class="filter-actions">
        <button class="action-btn secondary" bindtap="resetFilter">重置</button>
        <button class="action-btn primary" bindtap="applyFilter">确定</button>
      </view>
    </view>
  </view>

  <view wx:if="loading && artifactList.length === 0" class="loading-overlay">
    <text class="loading-text">加载中...</text>
  </view>
</view>